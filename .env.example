# Local development. Copy to .env (git-ignored).
AWS_REGION=us-east-1
AWS_PROFILE=backlog-crew
MODEL_ID=anthropic.claude-opus-5-5
# MODEL_ID_REVIEWER=anthropic.claude-sonnet-5-5   # optional per-agent override
# Repos the crew may work on: owner/name,owner/other  (or * for any the token can reach)
ALLOWED_REPOS=
# CDK output BacklogCrew.GatewayUrl
GATEWAY_URL=
# Locally, a fine-grained PAT stands in for the AgentCore Identity provider.
GITHUB_TOKEN=
WORKSPACE_ROOT=./.workspaces
MAX_REVIEW_ROUNDS=2
