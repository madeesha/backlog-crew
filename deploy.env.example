# Deployment settings for scripts/deploy.sh.
# Copy to deploy.env (git-ignored) and fill in. Nothing here is a secret, but it is yours:
# account, region and repo names stay out of the public repo.

# AWS CLI profile to deploy with (`aws configure sso` / `aws sso login --profile ...`).
AWS_PROFILE=<aws-profile>
# Region with AgentCore and Bedrock. Leave empty to use the profile's region.
AWS_REGION=

# Repos the crew may work on: owner/name,owner/other  (or * for any the token reaches).
ALLOWED_REPOS=owner/repo

# Bedrock model or inference-profile id. List what your region offers with:
#   aws bedrock list-inference-profiles --query "inferenceProfileSummaries[].inferenceProfileId"
MODEL_ID=global.anthropic.claude-opus-5-5

# Secrets Manager secret holding the GitHub token as {"token":"..."}.
# scripts/put-github-token.sh creates or updates it.
GITHUB_TOKEN_SECRET=backlog-crew/github
